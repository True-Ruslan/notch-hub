diff --git a/src/adapter/capabilities.m b/src/adapter/capabilities.m
new file mode 100644
--- /dev/null
+++ b/src/adapter/capabilities.m
@@ -0,0 +1,150 @@
+// NotchHub development-only compatibility probe extension.
+// This file is applied as a repo-owned patch over the pinned upstream adapter.
+
+#import <Foundation/Foundation.h>
+
+#import "MediaRemoteAdapter.h"
+#import "utility/helpers.h"
+
+typedef const void *MROriginRef;
+
+typedef MROriginRef (*MRMediaRemoteGetLocalOrigin_t)(void);
+typedef void (*MRMediaRemoteGetSupportedCommandsForOrigin_t)(
+    MROriginRef origin,
+    dispatch_queue_t queue,
+    void (^completion)(CFArrayRef commands));
+typedef void (*MRMediaRemoteCopySupportedCommands_t)(
+    dispatch_queue_t queue,
+    void (^completion)(NSArray *commands));
+typedef NSInteger (*MRMediaRemoteCommandInfoGetCommand_t)(id commandInfo);
+typedef Boolean (*MRMediaRemoteCommandInfoGetEnabled_t)(id commandInfo);
+
+typedef enum {
+    kMRASeekToPlaybackPosition = 24,
+} MRACapabilityCommand;
+
+static NSString *const kMRAStateSupported = @"supported";
+static NSString *const kMRAStateUnsupported = @"unsupported";
+static NSString *const kMRAStateUnknown = @"unknown";
+
+static const int64_t kMRACapabilityTimeoutNanoseconds = 2 * NSEC_PER_SEC;
+
+static CFBundleRef createMediaRemoteBundle(void) {
+    NSURL *url = [NSURL fileURLWithPath:
+        @"/System/Library/PrivateFrameworks/MediaRemote.framework"];
+    return CFBundleCreate(kCFAllocatorDefault, (__bridge CFURLRef)url);
+}
+
+static void *functionPointer(CFBundleRef bundle, CFStringRef name) {
+    if (bundle == NULL) {
+        return NULL;
+    }
+    return CFBundleGetFunctionPointerForName(bundle, name);
+}
+
+static NSArray *copySupportedCommands(CFBundleRef bundle) {
+    MRMediaRemoteGetLocalOrigin_t getLocalOrigin =
+        (MRMediaRemoteGetLocalOrigin_t)functionPointer(
+            bundle, CFSTR("MRMediaRemoteGetLocalOrigin"));
+    MRMediaRemoteGetSupportedCommandsForOrigin_t getForOrigin =
+        (MRMediaRemoteGetSupportedCommandsForOrigin_t)functionPointer(
+            bundle, CFSTR("MRMediaRemoteGetSupportedCommandsForOrigin"));
+    MRMediaRemoteCopySupportedCommands_t copyLegacy =
+        (MRMediaRemoteCopySupportedCommands_t)functionPointer(
+            bundle, CFSTR("MRMediaRemoteCopySupportedCommands"));
+
+    dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+    dispatch_queue_t queue = dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0);
+    __block NSArray *commands = nil;
+
+    if (getLocalOrigin != NULL && getForOrigin != NULL) {
+        MROriginRef origin = getLocalOrigin();
+        if (origin == NULL) {
+            return nil;
+        }
+        getForOrigin(origin, queue, ^(CFArrayRef result) {
+            if (result != NULL) {
+                commands = [(__bridge NSArray *)result copy];
+            }
+            dispatch_semaphore_signal(semaphore);
+        });
+    }
+    else if (copyLegacy != NULL) {
+        copyLegacy(queue, ^(NSArray *result) {
+            if (result != nil) {
+                commands = [result copy];
+            }
+            dispatch_semaphore_signal(semaphore);
+        });
+    }
+    else {
+        return nil;
+    }
+
+    if (dispatch_semaphore_wait(
+            semaphore,
+            dispatch_time(DISPATCH_TIME_NOW, kMRACapabilityTimeoutNanoseconds)) != 0) {
+        return nil;
+    }
+    return commands;
+}
+
+static NSMutableDictionary *unknownCapabilities(void) {
+    return [@{
+        @"next": kMRAStateUnknown,
+        @"previous": kMRAStateUnknown,
+        @"seek": kMRAStateUnknown,
+    } mutableCopy];
+}
+
+static void setSupportedIfEnabled(
+    NSMutableDictionary *result,
+    NSInteger command,
+    Boolean enabled) {
+    if (!enabled) {
+        return;
+    }
+
+    if (command == kMRANextTrack) {
+        result[@"next"] = kMRAStateSupported;
+    }
+    else if (command == kMRAPreviousTrack) {
+        result[@"previous"] = kMRAStateSupported;
+    }
+    else if (command == kMRASeekToPlaybackPosition) {
+        result[@"seek"] = kMRAStateSupported;
+    }
+}
+
+void adapter_capabilities(void) {
+    NSMutableDictionary *result = unknownCapabilities();
+    CFBundleRef bundle = createMediaRemoteBundle();
+    if (bundle == NULL) {
+        printOut(serializeJsonDictionarySafe(result, false));
+        return;
+    }
+
+    MRMediaRemoteCommandInfoGetCommand_t getCommand =
+        (MRMediaRemoteCommandInfoGetCommand_t)functionPointer(
+            bundle, CFSTR("MRMediaRemoteCommandInfoGetCommand"));
+    MRMediaRemoteCommandInfoGetEnabled_t getEnabled =
+        (MRMediaRemoteCommandInfoGetEnabled_t)functionPointer(
+            bundle, CFSTR("MRMediaRemoteCommandInfoGetEnabled"));
+    NSArray *commands = copySupportedCommands(bundle);
+
+    if (getCommand != NULL && getEnabled != NULL && commands != nil) {
+        result[@"next"] = kMRAStateUnsupported;
+        result[@"previous"] = kMRAStateUnsupported;
+        result[@"seek"] = kMRAStateUnsupported;
+
+        for (id commandInfo in commands) {
+            setSupportedIfEnabled(
+                result,
+                getCommand(commandInfo),
+                getEnabled(commandInfo));
+        }
+    }
+
+    CFRelease(bundle);
+    printOut(serializeJsonDictionarySafe(result, false));
+}
